{
  "id": "myapp",
  "name": "MyApp",
  "publisher": "Your Name",
  "description": "One sentence about what MyApp does.",
  "version": "1.0.0",

  "repo": "owner/myapp",
  "branch": "main",
  "repoPath": "",
  "releasesRepo": "owner/myapp",
  "tagFormat": "v{version}",

  "windows": {
    "installDir": "%LOCALAPPDATA%\\Programs\\{name}",
    "system": {
      "windows": "10.0.19041",
      "memoryMb": 4096,
      "diskMb": 500,
      "vulkan": "1.3",
      "vulkanExtensions": [ "VK_KHR_swapchain", "VK_KHR_external_memory_win32", "VK_KHR_external_semaphore_win32" ],
      "d3d12": "11_0"
    },
    "binaries": [
      {
        "name": "myapp",
        "source": "target/myapp.exe",
        "addToPath": true,
        "shortcuts": { "desktop": true, "startMenu": true, "label": "MyApp" },
        "fileAssociations": [ { "extension": ".myapp", "description": "MyApp Project" } ]
      },
      {
        "name": "myapp-tool",
        "source": "target/myapp-tool-1.0-uber.jar",
        "file": "myapp-tool.jar",
        "javaMin": 21
      }
    ]
  }
}
